# =============================================================================
# Kyofuse Architecture — Local Environment Configuration
# =============================================================================
# Copy this file to `.env` before running docker compose:
#   cp .env.example .env
#
# This file provides the environment variables for Docker Compose services
# and the Spring Boot application configuration.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_DB=kyofuse
POSTGRES_USER=kyofuse
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5432

# Application database user (Least Privilege Principle)
DB_URL=jdbc:postgresql://localhost:5432/kyofuse
DB_APP_USERNAME=kyofuse
DB_APP_PASSWORD=postgres_dev_password
DB_MIGRATION_USERNAME=kyofuse
DB_MIGRATION_PASSWORD=postgres_dev_password
FLYWAY_ENABLED=true

# -----------------------------------------------------------------------------
# Cache, Presence & Rate Limiting (Redis 8)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# -----------------------------------------------------------------------------
# Local Mock SMTP Server (Mailpit)
# -----------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_FROM=Kyofuse <noreply@kyofuse.com>

# -----------------------------------------------------------------------------
# S3-Compatible Object Storage (MinIO)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=kyofuse_storage_admin
STORAGE_SECRET_KEY=kyofuse_storage_secret_key_123
STORAGE_BUCKET=kyofuse-media
STORAGE_REGION=us-east-1

# -----------------------------------------------------------------------------
# Observability (Prometheus & Grafana)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Security & Cryptography (JWT, AES-GCM, Blind Index, TOTP)
# -----------------------------------------------------------------------------
# JWT signing key (Min 256 bits / 32 bytes)
JWT_SECRET=super-secret-jwt-signing-key-for-local-dev-must-be-very-long-and-secure
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# Distinct secret for pending 2FA authentication phase (Prevents privilege escalation)
MFA_JWT_SECRET=another-super-secret-key-specifically-for-mfa-tokens-different-from-jwt

# Account Reactivation Token Secret (Grace period account restoration)
REACTIVATION_JWT_SECRET=another-super-secret-key-specifically-for-reactivation-tokens

# AES-256-GCM Encryption Key for sensitive fields (Base64-encoded 256-bit key)
# Generated via: openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=WnZr4u7x!A%D*G-KaPdSgVkYp3s6v9y/B?E(H+MbQeThWmZq4t7w!z%C&F)J@NcR

# Blind Index Secret for searching encrypted fields via deterministic HMAC-SHA256
# Generated via: openssl rand -base64 32
EMAIL_INDEX_SECRET=8x/A?D(G+KbPeShVmYq3t6w9z$B&E)H@McQfTjWnZr4u7x!A%D*G-KaPdSgUkXp2

# Base64-encoded 256-bit key used to encrypt TOTP secrets at rest in database
TOTP_ENCRYPTION_KEY=s6v9y$B&E)H@McQfTjWnZr4t7w!z%C*F-JaNdRgUkXp2s5v8x/A?D(G+KbPeShVm

# Cookie security settings (false for localhost HTTP dev, true for HTTPS prod)
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Application Networking & External Integrations
# -----------------------------------------------------------------------------
SERVER_PORT=8080
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional 3rd-Party APIs (Leaves empty if not using live external providers)
GOOGLE_CLIENT_ID=
STEAM_API_KEY=
FACEIT_API_KEY=
GAMERSCLUB_SCRAPER_API_KEY=
GAMERSCLUB_SCRAPER_URL=https://api.scraperapi.com
GAMERSCLUB_BOT_COOKIE=
